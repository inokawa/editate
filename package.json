{
  "name": "editate",
  "version": "0.7.0",
  "description": "An experimental, type-safe, framework agnostic and small (5kB+) contenteditable state manager.",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "tsc": "tsc -p . --noEmit",
    "test": "vitest --run --project unit",
    "test:browser": "vitest --run --project browser",
    "format": "prettier '**/*.{js,ts,jsx,tsx}' --write --cache",
    "format:ci": "prettier '**/*.{js,ts,jsx,tsx}' -l",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e": "npx playwright test",
    "typedoc": "typedoc",
    "size": "size-limit",
    "prepare": "patch-package",
    "prepublishOnly": "npm run typedoc && rimraf lib && npm run build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@non-standardworld/stone-engine.js": "^0.2.0",
    "@playwright/test": "1.61.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-text": "^15.8.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "ai": "^7.0.164",
    "diff": "^9.0.0",
    "jsdom": "^31.0.0",
    "kuromojin": "^3.0.1",
    "linkifyjs": "^4.4.0",
    "node-emoji": "^2.2.0",
    "patch-package": "^8.0.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rimraf": "6.1.4",
    "shiki": "^4.6.0",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.6",
    "terser": "^5.51.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "^7.0.0",
    "unified": "^11.0.5",
    "valibot": "^1.5.0",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inokawa/editate.git"
  },
  "keywords": [
    "contenteditable",
    "ui",
    "headless",
    "textarea",
    "input",
    "form",
    "highlight",
    "autocomplete",
    "tagging",
    "combobox",
    "richtext",
    "editor",
    "wysiwyg",
    "react",
    "vue",
    "svelte",
    "solid",
    "angular",
    "preact",
    "alpine",
    "marko",
    "octane"
  ],
  "author": "inokawa <stratoooo-taster@yahoo.co.jp> (https://github.com/inokawa/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inokawa/editate/issues"
  },
  "homepage": "https://github.com/inokawa/editate#readme"
}
